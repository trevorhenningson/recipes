{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trevorhenningson.github.io/recipes/recipe.schema.json",
  "title": "Recipe",
  "description": "One recipe file in recipes/<slug>.json. Definitions cover every record type the app uses.",
  "$ref": "#/definitions/Recipe",
  "definitions": {
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "Unit": {
      "type": "string",
      "enum": ["g", "kg", "ml", "l", "fl-oz", "tsp", "tbsp", "cup", "oz", "lb", "clove", "whole", "pinch", "can", "bunch", "slice"]
    },
    "IngredientCategory": {
      "type": "string",
      "enum": ["produce", "meat", "seafood", "dairy", "pantry", "spices", "bakery", "frozen", "other"]
    },
    "IngredientLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/definitions/Slug", "description": "Must exist in ingredients.json." },
        "quantity": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "unit": { "oneOf": [{ "$ref": "#/definitions/Unit" }, { "type": "null" }] },
        "prep": { "type": "string", "minLength": 1, "maxLength": 200 },
        "optional": { "type": "boolean" },
        "note": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "Component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ingredients"],
      "properties": {
        "name": { "type": ["string", "null"], "maxLength": 80 },
        "ingredients": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/IngredientLine" } }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "Recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "tags", "servings", "components", "steps"],
      "properties": {
        "slug": { "$ref": "#/definitions/Slug", "description": "Must equal the file name." },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/Slug" } },
        "servings": { "type": "number", "exclusiveMinimum": 0 },
        "prepMinutes": { "type": "integer", "minimum": 0 },
        "cookMinutes": { "type": "integer", "minimum": 0 },
        "description": { "type": "string", "minLength": 1, "maxLength": 400 },
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/Component" } },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
        "source": { "$ref": "#/definitions/Source" },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "image": { "type": "string", "minLength": 1 },
        "submittedBy": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "Ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category"],
      "properties": {
        "id": { "$ref": "#/definitions/Slug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "category": { "$ref": "#/definitions/IngredientCategory" },
        "pantryStaple": { "type": "boolean" },
        "gramsPerCup": { "type": "number", "exclusiveMinimum": 0, "description": "Enables mass <-> volume conversion." }
      }
    },
    "IngredientList": { "type": "array", "items": { "$ref": "#/definitions/Ingredient" } },
    "Tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/definitions/Slug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "TagList": { "type": "array", "items": { "$ref": "#/definitions/Tag" } },
    "RecipeIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generatedAt", "ingredients", "tags", "recipes"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "ingredients": { "type": "array", "items": { "$ref": "#/definitions/Ingredient" } },
        "tags": { "type": "array", "items": { "$ref": "#/definitions/Tag" } },
        "recipes": { "type": "array", "items": { "$ref": "#/definitions/Recipe" } }
      }
    }
  }
}
